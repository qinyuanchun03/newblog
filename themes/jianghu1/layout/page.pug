extends layout.pug

block title
  title= page.title + ' | ' + config.title

block content
  include ../_partial/header.pug
  .container
    .row
      .col-md-9
        article.page
          h1.page-title= page.title
          .page-content
            != page.content
      .col-md-3
        include ../_partial/sidebar.pug
  include ../_partial/footer.pug