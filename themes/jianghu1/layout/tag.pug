extends layout.pug

block title
  title= page.tag + ' | ' + config.title

block content
  include ../_partial/header.pug
  .container
    .row
      .col-md-9
        h1.page-title= page.tag
        each post in page.posts.toArray()
          article.post
            h2.post-title
              a(href=url_for(post.path))= post.title
            .post-meta
              time(datetime=post.date.toISOString())= date(post.date, 'YYYY-MM-DD')
            .post-content
              != post.excerpt || post.content
            if post.excerpt
              a.read-more(href=url_for(post.path)) Read More
        include ../_partial/pagination.pug
      .col-md-3
        include ../_partial/sidebar.pug
  include ../_partial/footer.pug